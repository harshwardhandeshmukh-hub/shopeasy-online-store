# Server Port (default: 5000 for standalone backend, 3000 for AI Studio environment)
PORT=5000

# MongoDB Atlas Connection URI (leave blank to run in high-performance In-Memory Demo Mode)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/stylekart?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for user token signing & verification
JWT_SECRET=stylekart_jwt_secret_dev_key_2026

# Frontend API URL configuration
# When running separate Vite on port 5173: set to http://localhost:5000
# When running fullstack on same host: set to /api or empty
VITE_API_URL=http://localhost:5000

# App URL (injected automatically in cloud environments)
APP_URL=http://localhost:3000
